generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========== ENUMS ==========
enum UserStatus {
  active
  inactive
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  pending
  in_progress
  paused
  completed
  overdue
  cancelled
  reassigned
  qc_approved
  data_entered
}

enum PerformanceRating {
  Excellent
  Good
  Average
  Poor
  Lazy
}

enum NotificationType {
  frequency_missed
  performance
  general
  chat_message
  chat_mention
}

enum PeriodType {
  daily
  weekly
  monthly
}

// ---------- enums ----------
enum ConversationType {
  dm
  group
  client
  team
  assignment
  task
  support
}

enum MessageType {
  text
  image
  file
  system
}

enum PackageType {
  INDIVIDUAL
  BUSINESS
  CUSTOM
}

// ========== AUTHENTICATION MODELS ==========
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  passwordHash  String?

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  // Unified task system
  firstName String?
  lastName  String?
  phone     String?
  category  String?
  address   String?
  biography String?
  status    UserStatus @default(active)
  clientId  String?

  sessions                Session[]
  accounts                Account[]
  comments                Comment[]
  reports                 Report[]
  activityLogs            ActivityLog[]
  notifications           Notification[]
  assignedTasks           Task[]               @relation("AssignedTasks")
  clientTeamMemberships   ClientTeamMember[]
  templateTeamMemberships TemplateTeamMember[]

  // ✅ Chat back-relations
  createdConversations     Conversation[]            @relation("UserCreatedConversations")
  conversationParticipants ConversationParticipant[]
  sentMessages             ChatMessage[]             @relation("MessageSender")
  messageReactions         MessageReaction[]
  managedClients           Client[]                  @relation("AccountManagerClients")
  // 🆕 receipts back-relation
  messageReceipts          MessageReceipt[]
  lastSeenAt               DateTime?

  qcId     String?
  qc       User?   @relation("QC_Supervision", fields: [qcId], references: [id])
  qcAgents User[]  @relation("QC_Supervision")

  user_field_01 String?
  user_field_02 String?
  user_field_03 Int?
  user_field_04 Int?
  user_field_05 Boolean?
  user_field_06 Json?
  user_field_07 Json?
  user_field_08 Json?
  user_field_09 Json?
  user_field_10 Json?
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  session_field_01 String?
  session_field_02 String?
  session_field_03 Int?
  session_field_04 Int?
  session_field_05 Boolean?
  session_field_06 Json?
  session_field_07 Json?
  session_field_08 Json?
  session_field_09 Json?
  session_field_10 Json?

  @@index([impersonatedBy])
}

model Account {
  id         String @id @default(cuid())
  accountId  String
  providerId String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  account_field_01 String?
  account_field_02 String?
  account_field_03 Int?
  account_field_04 Int?
  account_field_05 Boolean?
  account_field_06 Json?
  account_field_07 Json?
  account_field_08 Json?
  account_field_09 Json?
  account_field_10 Json?
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  verification_field_01 String?
  verification_field_02 String?
  verification_field_03 Int?
  verification_field_04 Int?
  verification_field_05 Boolean?
  verification_field_06 Json?
  verification_field_07 Json?
  verification_field_08 Json?
  verification_field_09 Json?
  verification_field_10 Json?
}

// ========== ROLES & PERMISSIONS ==========
model Role {
  id              String           @id
  name            String           @unique
  description     String?
  users           User[]
  rolePermissions RolePermission[]

  role_field_01 String?
  role_field_02 String?
  role_field_03 Int?
  role_field_04 Int?
  role_field_05 Boolean?
  role_field_06 Json?
  role_field_07 Json?
  role_field_08 Json?
  role_field_09 Json?
  role_field_10 Json?
}

model Permission {
  id              String           @id
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]

  permission_field_01 String?
  permission_field_02 String?
  permission_field_03 Int?
  permission_field_04 Int?
  permission_field_05 Boolean?
  permission_field_06 Json?
  permission_field_07 Json?
  permission_field_08 Json?
  permission_field_09 Json?
  permission_field_10 Json?
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  rolepermission_field_01 String?
  rolepermission_field_02 String?
  rolepermission_field_03 Int?
  rolepermission_field_04 Int?
  rolepermission_field_05 Boolean?
  rolepermission_field_06 Json?
  rolepermission_field_07 Json?
  rolepermission_field_08 Json?
  rolepermission_field_09 Json?
  rolepermission_field_10 Json?

  @@id([roleId, permissionId])
}

// ========== TEAMS ==========
model Team {
  id                  String               @id
  name                String               @unique
  description         String?
  clientTeamMembers   ClientTeamMember[]
  templateTeamMembers TemplateTeamMember[]

  team_field_01 String?
  team_field_02 String?
  team_field_03 Int?
  team_field_04 Int?
  team_field_05 Boolean?
  team_field_06 Json?
  team_field_07 Json?
  team_field_08 Json?
  team_field_09 Json?
  team_field_10 Json?
}

// ========== PACKAGES ==========
model Package {
  id          String      @id @default(cuid())
  name        String?     @unique
  description String?
  totalMonths Int?
  type        PackageType @default(INDIVIDUAL)
  clients     Client[]
  templates   Template[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package_field_01 String?
  package_field_02 String?
  package_field_03 Int?
  package_field_04 Int?
  package_field_05 Boolean?
  package_field_06 Json?
  package_field_07 Json?
  package_field_08 Json?
  package_field_09 Json?
  package_field_10 Json?
}

// ========== TASK CATEGORIES ==========
model TaskCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  tasks       Task[]

  taskcategory_field_01 String?
  taskcategory_field_02 String?
  taskcategory_field_03 Int?
  taskcategory_field_04 Int?
  taskcategory_field_05 Boolean?
  taskcategory_field_06 Json?
  taskcategory_field_07 Json?
  taskcategory_field_08 Json?
  taskcategory_field_09 Json?
  taskcategory_field_10 Json?
}

// ========== CLIENTS ==========
model Client {
  id          String    @id @default(cuid())
  name        String
  birthdate   DateTime?
  gender      String?
  company     String?
  designation String?
  location    String?

  email          String?
  phone          String?
  password       String?
  recoveryEmail  String?
  websites       Json?
  biography      String?
  imageDrivelink String?

  articleTopics Json?

  companywebsite String?
  companyaddress String?
  avatar         String?
  progress       Int?      @default(0)
  status         String?
  packageId      String?
  package        Package?  @relation(fields: [packageId], references: [id])
  startDate      DateTime?
  renewalDate    DateTime?
  dueDate        DateTime?
  renewalCount   Int?      @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  otherField     Json?
  socialMedia    Json

  assignments Assignment[]
  teamMembers ClientTeamMember[]
  tasks       Task[]

  amId           String?
  accountManager User?   @relation("AccountManagerClients", fields: [amId], references: [id])

  client_field_01 String?
  client_field_02 String?
  client_field_03 Int?
  client_field_04 Int?
  client_field_05 Boolean?
  client_field_06 Json?
  client_field_07 Json?
  client_field_08 Json?
  client_field_09 Json?
  client_field_10 Json?

  @@index([amId])
}

// ========== CLIENT TEAM MEMBERS ==========
model ClientTeamMember {
  clientId       String
  agentId        String
  role           String?
  teamId         String?
  assignedDate   DateTime?
  assignedTasks  Int?      @default(0)
  completedTasks Int?      @default(0)
  lateTasks      Int?      @default(0)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent  User   @relation(fields: [agentId], references: [id])
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  clientteammember_field_01 String?
  clientteammember_field_02 String?
  clientteammember_field_03 Int?
  clientteammember_field_04 Int?
  clientteammember_field_05 Boolean?
  clientteammember_field_06 Json?
  clientteammember_field_07 Json?
  clientteammember_field_08 Json?
  clientteammember_field_09 Json?
  clientteammember_field_10 Json?

  @@id([clientId, agentId])
}

// ========== TEMPLATES ==========
model AssetType {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  categoryName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templateSiteAssets TemplateSiteAsset[]
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  packageId   String?
  package     Package? @relation(fields: [packageId], references: [id])
  status      String?

  templateTeamMembers TemplateTeamMember[]
  sitesAssets         TemplateSiteAsset[]
  assignments         Assignment[]

  template_field_01 String?
  template_field_02 String?
  template_field_03 Int?
  template_field_04 Int?
  template_field_05 Boolean?
  template_field_06 Json?
  template_field_07 Json?
  template_field_08 Json?
  template_field_09 Json?
  template_field_10 Json?
}

// ========== TEMPLATE SITES/ASSETS ==========
model TemplateSiteAsset {
  id                          Int           @id @default(autoincrement())
  templateId                  String
  template                    Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  type                        String
  assetType                   AssetType     @relation(fields: [type], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  name                        String
  url                         String?
  description                 String?
  isRequired                  Boolean
  defaultPostingFrequency     Int?
  defaultIdealDurationMinutes Int?
  defaultIdealDurationMinutesForPosting Int?

  assignmentSettings AssignmentSiteAssetSetting[]
  tasks              Task[]

  templatesiteasset_field_01 String?
  templatesiteasset_field_02 String?
  templatesiteasset_field_03 Int?
  templatesiteasset_field_04 Int?
  templatesiteasset_field_05 Boolean?
  templatesiteasset_field_06 Json?
  templatesiteasset_field_07 Json?
  templatesiteasset_field_08 Json?
  templatesiteasset_field_09 Json?
  templatesiteasset_field_10 Json?

  @@index([type])
}

// ========== TEMPLATE TEAM MEMBERS ==========
model TemplateTeamMember {
  templateId   String
  agentId      String
  role         String?
  teamId       String?
  assignedDate DateTime?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  agent    User     @relation(fields: [agentId], references: [id])
  team     Team?    @relation(fields: [teamId], references: [id], onDelete: Restrict)

  templateteammember_field_01 String?
  templateteammember_field_02 String?
  templateteammember_field_03 Int?
  templateteammember_field_04 Int?
  templateteammember_field_05 Boolean?
  templateteammember_field_06 Json?
  templateteammember_field_07 Json?
  templateteammember_field_08 Json?
  templateteammember_field_09 Json?
  templateteammember_field_10 Json?

  @@id([templateId, agentId])
}

// ========== ASSIGNMENTS ==========
model Assignment {
  id         String    @id
  templateId String?
  clientId   String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedAt DateTime? @default(now())
  status     String?

  tasks             Task[]
  siteAssetSettings AssignmentSiteAssetSetting[]

  assignment_field_01 String?
  assignment_field_02 String?
  assignment_field_03 Int?
  assignment_field_04 Int?
  assignment_field_05 Boolean?
  assignment_field_06 Json?
  assignment_field_07 Json?
  assignment_field_08 Json?
  assignment_field_09 Json?
  assignment_field_10 Json?
}

// ========== ASSIGNMENT SITE/ASSET SETTINGS ==========
model AssignmentSiteAssetSetting {
  id                  Int    @id @default(autoincrement())
  assignmentId        String
  templateSiteAssetId Int

  assignment           Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  templateSiteAsset    TemplateSiteAsset @relation(fields: [templateSiteAssetId], references: [id], onDelete: Cascade)
  requiredFrequency    Int?
  period               PeriodType        @default(monthly)
  idealDurationMinutes Int?

  assignmentsiteassetsetting_field_01 String?
  assignmentsiteassetsetting_field_02 String?
  assignmentsiteassetsetting_field_03 Int?
  assignmentsiteassetsetting_field_04 Int?
  assignmentsiteassetsetting_field_05 Boolean?
  assignmentsiteassetsetting_field_06 Json?
  assignmentsiteassetsetting_field_07 Json?
  assignmentsiteassetsetting_field_08 Json?
  assignmentsiteassetsetting_field_09 Json?
  assignmentsiteassetsetting_field_10 Json?
}

// ========== TASKS ==========
model Task {
  id                  String  @id
  assignmentId        String?
  clientId            String?
  templateSiteAssetId Int?
  categoryId          String?
  assignedToId        String?

  name                  String
  priority              TaskPriority       @default(medium)
  dueDate               DateTime?
  status                TaskStatus         @default(pending)
  idealDurationMinutes  Int?
  actualDurationMinutes Int?
  performanceRating     PerformanceRating?
  completionLink        String?
  taskCompletionJson    Json?
  email                 String?
  password              String?
  username              String?
  notes                 String?
  reassignNotes         String?
  completedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  qcReview             Json?
  qcTotalScore         Int?  @default(0)
  pauseReasons         Json? @default("[]")
  socialCommunications Json? @default("[]")
  dataEntryReport      Json?

  assignment        Assignment?        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  client            Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateSiteAsset TemplateSiteAsset? @relation(fields: [templateSiteAssetId], references: [id], onDelete: Cascade)
  category          TaskCategory?      @relation(fields: [categoryId], references: [id])
  assignedTo        User?              @relation("AssignedTasks", fields: [assignedToId], references: [id])

  comments      Comment[]
  reports       Report[]
  notifications Notification[]

  task_field_01 String?
  task_field_02 String?
  task_field_03 Int?
  task_field_04 Int?
  task_field_05 Boolean?
  task_field_06 Json?
  task_field_07 Json?
  task_field_08 Json?
  task_field_09 Json?
  task_field_10 Json?
}

// ========== COMMENTS ==========
model Comment {
  id       String   @id
  taskId   String?
  authorId String?
  text     String
  date     DateTime @default(now())

  task   Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id])

  comment_field_01 String?
  comment_field_02 String?
  comment_field_03 Int?
  comment_field_04 Int?
  comment_field_05 Boolean?
  comment_field_06 Json?
  comment_field_07 Json?
  comment_field_08 Json?
  comment_field_09 Json?
  comment_field_10 Json?
}

// ========== REPORTS ==========
model Report {
  id       String   @id
  taskId   String?
  authorId String?
  text     String
  severity String?
  date     DateTime @default(now())

  task   Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id])

  report_field_01 String?
  report_field_02 String?
  report_field_03 Int?
  report_field_04 Int?
  report_field_05 Boolean?
  report_field_06 Json?
  report_field_07 Json?
  report_field_08 Json?
  report_field_09 Json?
  report_field_10 Json?
}

// ========== ACTIVITY LOG ==========
model ActivityLog {
  id         String   @id
  entityType String
  entityId   String
  userId     String?
  action     String
  timestamp  DateTime @default(now())
  details    Json?

  user User? @relation(fields: [userId], references: [id])

  activitylog_field_01 String?
  activitylog_field_02 String?
  activitylog_field_03 Int?
  activitylog_field_04 Int?
  activitylog_field_05 Boolean?
  activitylog_field_06 Json?
  activitylog_field_07 Json?
  activitylog_field_08 Json?
  activitylog_field_09 Json?
  activitylog_field_10 Json?
}

// ========== NOTIFICATIONS ==========
model Notification {
  id        Int              @id @default(autoincrement())
  userId    String
  taskId    String?
  type      NotificationType
  message   String
  createdAt DateTime         @default(now())
  isRead    Boolean          @default(false)

  user User  @relation(fields: [userId], references: [id])
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  notification_field_01 String?
  notification_field_02 String?
  notification_field_03 Int?
  notification_field_04 Int?
  notification_field_05 Boolean?
  notification_field_06 Json?
  notification_field_07 Json?
  notification_field_08 Json?
  notification_field_09 Json?
  notification_field_10 Json?
}

// ---------- models ----------
model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType @default(dm)
  title       String?
  createdById String?
  createdBy   User?            @relation("UserCreatedConversations", fields: [createdById], references: [id])

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  participants ConversationParticipant[]
  messages     ChatMessage[]

  conversation_field_01 String?
  conversation_field_02 String?
  conversation_field_03 Int?
  conversation_field_04 Int?
  conversation_field_05 Boolean?
  conversation_field_06 Json?
  conversation_field_07 Json?
  conversation_field_08 Json?
  conversation_field_09 Json?
  conversation_field_10 Json?

  @@index([type])
}

model ConversationParticipant {
  conversationId String
  userId         String
  role           String? // "owner" | "member" | ইত্যাদি
  lastReadAt     DateTime?
  isMuted        Boolean   @default(false)
  isPinned       Boolean   @default(false)
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationparticipant_field_01 String?
  conversationparticipant_field_02 String?
  conversationparticipant_field_03 Int?
  conversationparticipant_field_04 Int?
  conversationparticipant_field_05 Boolean?
  conversationparticipant_field_06 Json?
  conversationparticipant_field_07 Json?
  conversationparticipant_field_08 Json?
  conversationparticipant_field_09 Json?
  conversationparticipant_field_10 Json?

  @@id([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String?
  type           MessageType @default(text)
  content        String?
  attachments    Json?
  replyToId      String?
  mentions       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?             @relation("MessageSender", fields: [senderId], references: [id])
  replyTo      ChatMessage?      @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      ChatMessage[]     @relation("MessageReplies")
  reactions    MessageReaction[]

  receipts MessageReceipt[]

  chatmessage_field_01 String?
  chatmessage_field_02 String?
  chatmessage_field_03 Int?
  chatmessage_field_04 Int?
  chatmessage_field_05 Boolean?
  chatmessage_field_06 Json?
  chatmessage_field_07 Json?
  chatmessage_field_08 Json?
  chatmessage_field_09 Json?
  chatmessage_field_10 Json?

  @@index([conversationId, createdAt])
}

model MessageReceipt {
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  messagereceipt_field_01 String?
  messagereceipt_field_02 String?
  messagereceipt_field_03 Int?
  messagereceipt_field_04 Int?
  messagereceipt_field_05 Boolean?
  messagereceipt_field_06 Json?
  messagereceipt_field_07 Json?
  messagereceipt_field_08 Json?
  messagereceipt_field_09 Json?
  messagereceipt_field_10 Json?

  @@id([messageId, userId])
  @@index([userId, messageId])
}

model MessageReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  messagereaction_field_01 String?
  messagereaction_field_02 String?
  messagereaction_field_03 Int?
  messagereaction_field_04 Int?
  messagereaction_field_05 Boolean?
  messagereaction_field_06 Json?
  messagereaction_field_07 Json?
  messagereaction_field_08 Json?
  messagereaction_field_09 Json?
  messagereaction_field_10 Json?

  @@id([messageId, userId, emoji])
}
